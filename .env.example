# clai team server configuration (copy to .env for docker compose, or export in the shell)
PORT=8787
HOST=0.0.0.0
CLAI_HOME=/var/lib/clai
# CLAI_DB=/var/lib/clai/clai.db
CLAI_TZ=Europe/Berlin
# Fix the bootstrap admin token (otherwise one is generated and printed on first start)
# CLAI_ADMIN_TOKEN=clai_adm_change-me
CLAI_ADMIN_EMAIL=admin@example.com
CLAI_PULL_INTERVAL_MINUTES=60

# Provider connectors for scheduled pulls (alternatively: clai connect <id> --set key=value on the server host)
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...
# OPENAI_ADMIN_KEY=sk-admin-...
# OPENROUTER_API_KEY=sk-or-v1-...
# CURSOR_API_KEY=key_...
# GITHUB_TOKEN=ghp_...

# CLI extras
# ANTHROPIC_API_KEY=sk-ant-...        # for `clai ask`
# CLAI_SYNC_SERVER=https://clai.example.com
# CLAI_SYNC_TOKEN=clai_mem_...
