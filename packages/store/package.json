{
  "name": "@claii/store",
  "version": "0.2.0",
  "description": "clai storage: the async EventStore interface, a SQLite (node:sqlite) implementation and an injected-primitive conformance suite.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./testing": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@claii/core": "0.2.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vcgetter22/clai"
  },
  "homepage": "https://github.com/vcgetter22/clai#readme",
  "bugs": {
    "url": "https://github.com/vcgetter22/clai/issues"
  }
}
